{
  "version": "0.1.0",
  "note": "字段默认值为占位。拿到组委会模板后，用 ingest 模块的字段比对报告在 aliases 里补齐映射即可，不必改代码。",
  "required_fields": [
    "disaster_type",
    "occur_date",
    "province",
    "county",
    "direct_economic_loss"
  ],
  "fields": [
    {"name": "record_id",      "label": "记录编号",   "dtype": "string",   "role": "attr",     "required": false},
    {"name": "disaster_type",  "label": "灾种",       "dtype": "string",   "role": "disaster", "required": true},
    {"name": "occur_date",     "label": "发生时间",   "dtype": "datetime", "role": "time",     "required": true},
    {"name": "emergency_level","label": "灾情等级",   "dtype": "string",   "role": "attr",     "required": false},

    {"name": "province",       "label": "省",         "dtype": "string",   "role": "region", "level": 1, "required": true},
    {"name": "province_code",  "label": "省级代码",   "dtype": "string",   "role": "region", "level": 1, "required": false},
    {"name": "city",           "label": "市（州）",   "dtype": "string",   "role": "region", "level": 2, "required": false},
    {"name": "city_code",      "label": "市级代码",   "dtype": "string",   "role": "region", "level": 2, "required": false},
    {"name": "county",         "label": "县（区）",   "dtype": "string",   "role": "region", "level": 3, "required": true},
    {"name": "county_code",    "label": "县级代码",   "dtype": "string",   "role": "region", "level": 3, "required": false},
    {"name": "town",           "label": "乡（镇）",   "dtype": "string",   "role": "region", "level": 4, "required": false},
    {"name": "town_code",      "label": "乡级代码",   "dtype": "string",   "role": "region", "level": 4, "required": false},
    {"name": "village",        "label": "村（社区）", "dtype": "string",   "role": "region", "level": 5, "required": false},
    {"name": "village_code",   "label": "村级代码",   "dtype": "string",   "role": "region", "level": 5, "required": false},

    {"name": "year",            "label": "年", "dtype": "int", "role": "derived", "required": false},
    {"name": "quarter",         "label": "季", "dtype": "int", "role": "derived", "required": false},
    {"name": "month",           "label": "月", "dtype": "int", "role": "derived", "required": false},
    {"name": "day",             "label": "日", "dtype": "int", "role": "derived", "required": false},
    {"name": "season",          "label": "汛期标记",   "dtype": "string", "role": "derived", "required": false},
    {"name": "per_capita_level","label": "人均损失分档", "dtype": "string", "role": "derived", "required": false}
  ],
  "aliases": {
    "记录编号": "record_id",
    "编号": "record_id",
    "灾种": "disaster_type",
    "灾害类型": "disaster_type",
    "灾害种类": "disaster_type",
    "发生时间": "occur_date",
    "灾害发生时间": "occur_date",
    "统计时间": "occur_date",
    "灾情等级": "emergency_level",
    "响应等级": "emergency_level",
    "省": "province",
    "省份": "province",
    "市": "city",
    "市州": "city",
    "县": "county",
    "区县": "county",
    "乡镇": "town",
    "村": "village"
  },
  "metrics": {
    "deaths":                {"label": "因灾死亡失踪人口", "unit": "人",     "agg": "sum", "loss_group": "人员伤亡",     "fill": 0, "bounds": [0, 1000000]},
    "injured":               {"label": "因灾受伤人口",     "unit": "人",     "agg": "sum", "loss_group": "人员伤亡",     "fill": 0, "bounds": [0, 1000000]},
    "missing":               {"label": "因灾失踪人口",     "unit": "人",     "agg": "sum", "loss_group": "人员伤亡",     "fill": 0, "bounds": [0, 1000000]},
    "affected_population":   {"label": "受灾人口",         "unit": "人",     "agg": "sum", "loss_group": "人员影响",     "fill": 0, "bounds": [0, 100000000]},
    "evacuated":             {"label": "紧急转移安置人口", "unit": "人",     "agg": "sum", "loss_group": "人员影响",     "fill": 0, "bounds": [0, 100000000]},
    "collapsed_houses":      {"label": "倒塌房屋",         "unit": "间",     "agg": "sum", "loss_group": "房屋损失",     "fill": 0, "bounds": [0, 10000000]},
    "damaged_houses":        {"label": "损坏房屋",         "unit": "间",     "agg": "sum", "loss_group": "房屋损失",     "fill": 0, "bounds": [0, 10000000]},
    "affected_crop_area":    {"label": "农作物受灾面积",   "unit": "千公顷", "agg": "sum", "loss_group": "农业损失",     "fill": 0, "bounds": [0, 100000]},
    "destroyed_crop_area":   {"label": "农作物绝收面积",   "unit": "千公顷", "agg": "sum", "loss_group": "农业损失",     "fill": 0, "bounds": [0, 100000]},
    "direct_economic_loss":  {"label": "直接经济损失",     "unit": "万元",   "agg": "sum", "loss_group": "财产损失",     "fill": 0, "bounds": [0, 100000000]},
    "infrastructure_loss":   {"label": "基础设施损失",     "unit": "万元",   "agg": "sum", "loss_group": "基础设施损失", "fill": 0, "bounds": [0, 100000000]},
    "agriculture_loss":      {"label": "农业损失",         "unit": "万元",   "agg": "sum", "loss_group": "农业损失",     "fill": 0, "bounds": [0, 100000000]},
    "housing_loss":          {"label": "房屋及家庭财产损失", "unit": "万元", "agg": "sum", "loss_group": "房屋损失",     "fill": 0, "bounds": [0, 100000000]}
  },
  "loss_structure_groups": [
    {"name": "人员伤亡",     "metrics": ["deaths", "injured", "missing"], "unit": "人"},
    {"name": "财产损失",     "metrics": ["direct_economic_loss"],          "unit": "万元"},
    {"name": "基础设施损失", "metrics": ["infrastructure_loss"],           "unit": "万元"},
    {"name": "农业损失",     "metrics": ["agriculture_loss"],              "unit": "万元"},
    {"name": "房屋损失",     "metrics": ["housing_loss"],                  "unit": "万元"}
  ],
  "dimensions": {
    "disaster_type":  {"label": "灾种",         "field": "disaster_type", "kind": "categorical", "custom": false,
                       "order": ["洪涝", "干旱", "地震", "地质灾害", "风雹", "低温冷冻", "雪灾", "森林火灾", "其他"]},
    "emergency_level":{"label": "灾情等级",     "field": "emergency_level", "kind": "categorical", "custom": false,
                       "order": ["特别重大", "重大", "较大", "一般"]},
    "time_year":      {"label": "年份",         "field": "year",   "kind": "temporal", "granularity": "year",  "custom": false},
    "time_quarter":   {"label": "季度",         "field": "quarter","kind": "temporal", "granularity": "quarter","custom": false},
    "time_month":     {"label": "月份",         "field": "month",  "kind": "temporal", "granularity": "month",  "custom": false},
    "time_day":       {"label": "日期",         "field": "day",    "kind": "temporal", "granularity": "day",    "custom": false},
    "region_province":{"label": "省",           "field": "province", "kind": "region", "level": 1, "custom": false},
    "region_city":    {"label": "市（州）",     "field": "city",     "kind": "region", "level": 2, "custom": false},
    "region_county":  {"label": "县（区）",     "field": "county",   "kind": "region", "level": 3, "custom": false},
    "region_town":    {"label": "乡（镇）",     "field": "town",     "kind": "region", "level": 4, "custom": false},
    "loss_structure": {"label": "损失结构",     "kind": "virtual", "handler": "loss_structure", "custom": false},
    "custom_season":  {"label": "汛期标记",     "field": "season", "kind": "categorical", "custom": true,
                       "order": ["汛期", "非汛期"]},
    "custom_per_capita": {"label": "人均损失分档", "field": "per_capita_level", "kind": "categorical", "custom": true}
  }
}
